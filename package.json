{
  "name": "naukri-profile-manager",
  "description": "GitHub Action and self-hosted scheduler for Naukri resume headline updates and uploads",
  "version": "1.0.0",
  "author": "Pratham Jaiswal",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/pratham-jaiswal/naukri-profile-manager",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pratham-jaiswal/naukri-profile-manager.git"
  },
  "bugs": {
    "url": "https://github.com/pratham-jaiswal/naukri-profile-manager/issues"
  },
  "keywords": [
    "actions",
    "naukri",
    "resume",
    "profile",
    "headline",
    "job",
    "automation"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "bash ./script/setup.sh",
    "start": "bash ./script/start.sh",
    "start:check": "bash ./script/start.sh --check",
    "bundle": "npm run format:write && npm run package",
    "ci-test": "node --experimental-vm-modules --no-warnings ./node_modules/jest/bin/jest.js",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint src",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "package": "npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "npm run package -- --watch",
    "test": "node --experimental-vm-modules --no-warnings ./node_modules/jest/bin/jest.js",
    "all": "npm run format:write && npm run lint && npm run test && npm run coverage && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "axios": "^1.20.0",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@github/local-action": "^7.0.1",
    "@jest/globals": "^30.5.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.9.10",
    "prettier-eslint": "^17.1.2",
    "rollup": "^4.65.0",
    "ts-jest": "^29.4.15",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  },
  "overrides": {
    "@fastify/busboy": "^3.2.4",
    "undici": "^6.29.1"
  },
  "resolutions": {
    "undici": "^6.29.1",
    "@fastify/busboy": "^3.2.4"
  }
}
